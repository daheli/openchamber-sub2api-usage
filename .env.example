# Copy to .env and set permissions to 600. Never commit .env.
# These two provider API keys are used only by the local extension service.
SUB2API_API_ORIGIN=https://gateway.example.com
SUB2API_KEY_1_ID=1
SUB2API_KEY_1_NAME=example-key-b
SUB2API_KEY_1_TOKEN=replace-with-key-1
SUB2API_KEY_2_ID=2
SUB2API_KEY_2_NAME=example-key-a
SUB2API_KEY_2_TOKEN=replace-with-key-2
